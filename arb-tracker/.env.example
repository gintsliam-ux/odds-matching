VITE_SUPABASE_URL=https://qmmhejvjcpkhiqrygcta.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER exposed to the browser (no VITE_ prefix, so Vite
# won't bundle it). Used by scripts/resolve-player-countries.mjs to upsert
# tennis flags directly instead of emitting SQL. Omit it and the script falls
# back to writing supabase/seed-player-countries.sql for you to run by hand.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
