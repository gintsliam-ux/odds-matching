# Copy to .env.api on the NAS and fill in. Do not commit the real file.
#
# From inside a container on the NAS, Mongo is reachable on the host — use
# host.docker.internal, the NAS LAN address, or 127.0.0.1 with network_mode:
# host. The Tailscale address works too but goes the long way round.
MONGO_URI=mongodb://user:password@127.0.0.1:27017/?authSource=admin
MONGO_DB=gutsys_sport

# Cloudflare named-tunnel token (Zero Trust → Networks → Tunnels → the tunnel →
# Install connector). Route the tunnel's hostname to http://api:8788 in the
# dashboard's Public Hostname tab, and put that hostname in ../vercel.json.
TUNNEL_TOKEN=

# Only needed when the page calls this API directly (cross-origin). Behind the
# Vercel rewrite every request is same-origin and carries no Origin header, so
# this can stay empty. It is a read-only archive and sets no cookies, so an
# empty list allows any origin rather than breaking anything.
ALLOWED_ORIGINS=https://odds-matching.vercel.app

# Optional shared key, the way the existing odds API does it (?key=...). OFF by
# default, and worth understanding before switching on: the site is public and
# unauthenticated, so everything this serves is already readable through the
# page. A key stops casual scraping of the tunnel hostname, nothing more — and
# if the page reaches the API through the Vercel rewrite, the key has to live in
# ../vercel.json, which is in a PUBLIC repo. Turn it on only alongside a plan
# for where the key lives.
API_KEY=

# One line per API call, with its duration.
LOG_REQUESTS=1
